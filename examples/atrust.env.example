# COPY OUTSIDE THE REPOSITORY before editing. Never store real VPN credentials here.
# latest is an upstream example; record/pin the verified image for repeatable use.
ATRUST_IMAGE=hagb/docker-atrust:latest
# Set after checking the image and runtime, e.g. linux/arm64 or linux/amd64.
ATRUST_PLATFORM=
# Replace with an existing private absolute directory on your machine.
ATRUST_STATE_DIR=/absolute/private/path/atrust-state
ATRUST_SOCKS_PORT=1080
ATRUST_VNC_PORT=5901
# VNC UI password only, NOT your aTrust account password. See upstream length limit.
ATRUST_VNC_PASSWORD=
